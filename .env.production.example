# Production environment for docker compose. Copy to .env.production on the
# VPS (chmod 600) and fill in. Never commit the filled-in file.

APP_DOMAIN=fieldops.example.com
APP_URL=https://fieldops.example.com

# Neon: pooled host for runtime queries, direct host for migrations and pg-boss.
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.us-east-2.aws.neon.tech/fieldops?sslmode=require
DIRECT_DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx.us-east-2.aws.neon.tech/fieldops?sslmode=require

BETTER_AUTH_SECRET=

STORAGE_DRIVER=r2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=fieldops-private

MAIL_TRANSPORT=smtp
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="M&N FieldOps <fieldops@example.com>"

WORKER_HEAVY_CONCURRENCY=1
