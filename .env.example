# ---------------------------------------------------------------------------
# M&N FieldOps environment. Copy to .env and fill in. Never commit .env.
# ---------------------------------------------------------------------------

# Public base URL of the web app (used in invitation/reset links and auth).
APP_URL=http://localhost:3000

# Runtime database connection used by the web app and worker queries.
# Local: plain PostgreSQL. Neon: the POOLED host (endpoint id + "-pooler").
DATABASE_URL=postgresql://fieldops:fieldops_dev@localhost:5432/mne_fieldops

# Direct (non-pooled) connection. Required for Prisma migrations and for the
# pg-boss queue, which needs session features (LISTEN/NOTIFY, advisory locks)
# that Neon's PgBouncer transaction pooling does not provide.
# Local: same as DATABASE_URL. Neon: the host WITHOUT "-pooler".
DIRECT_DATABASE_URL=postgresql://fieldops:fieldops_dev@localhost:5432/mne_fieldops

# Isolated database for integration tests (dropped/migrated by the test setup).
TEST_DATABASE_URL=postgresql://fieldops:fieldops_dev@localhost:5432/mne_fieldops_test

# Better Auth secret: 32+ random bytes, e.g. `openssl rand -base64 32`.
BETTER_AUTH_SECRET=replace-with-a-long-random-secret

# Storage adapter: "local" (private filesystem, development) or "r2".
STORAGE_DRIVER=local
LOCAL_STORAGE_DIR=./.data/storage
# Cloudflare R2 (S3-compatible API). Bucket must be private.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Optional override; defaults to https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com
R2_ENDPOINT=

# Mail transport: "outbox" (development only, stored in the database and shown
# at /dev/outbox) or "smtp". Production must use smtp.
MAIL_TRANSPORT=outbox
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="M&N FieldOps <no-reply@example.com>"

# Worker: Python interpreter with pdfplumber installed (see requirements.txt).
PYTHON_BIN=python3
# Optional Chromium executable for report rendering (defaults to Playwright's).
PLAYWRIGHT_CHROMIUM_EXECUTABLE=
# Heavy PDF jobs (extraction + report rendering) processed at a time.
WORKER_HEAVY_CONCURRENCY=1
